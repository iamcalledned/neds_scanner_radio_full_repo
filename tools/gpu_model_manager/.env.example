# Example environment variables for GPU Model Manager
# Copy to .env and edit as needed.

# Web app binding
GPU_MGR_HOST=127.0.0.1
GPU_MGR_PORT=8020

# VRAM safety defaults
GPU_SAFETY_MARGIN_MB=2500
SCANNER_WHISPER_RESERVED_MB=7000

# Scanner MCP reachability (HARDENED DEFAULT: port 8008)
SCANNER_MCP_URL=http://127.0.0.1:8008/mcp

# Local LLM (example) — adjust if your server binds to LAN IP
LOCAL_LLM_BASE_URL=http://192.168.86.53:30000
LOCAL_LLM_MODELS_URL=${LOCAL_LLM_BASE_URL}/v1/models
LOCAL_LLM_CHAT_URL=${LOCAL_LLM_BASE_URL}/v1/chat/completions

# Meeting MCP
MEETING_MCP_URL=http://127.0.0.1:8011/mcp

# Paths
LEASE_FILE=state/leases.json
GPU_MGR_LOG_DIR=logs
GPU_MGR_LOG_LEVEL=INFO
GPU_MGR_RUNTIMES_CONFIG=config/runtimes.json

# Project roots (rarely changed)
#SCANNER_PROJECT_ROOT=/home/ned/Documents/neds_scanner_radio_full_pipeline_with_git
#GPU_MODEL_MANAGER_ROOT=tools/gpu_model_manager
