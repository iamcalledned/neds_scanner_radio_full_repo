# =============================================
#  Ned's Scanner Radio — Root Shared Environment
# =============================================
# Copy to .env and fill in your values.

# --- Database ---
SCANNER_DB_PATH=/path/to/scanner_calls.db

# --- Archive paths ---
ARCHIVE_BASE=/path/to/scanner_archive
REVIEW_DIR=/path/to/scanner_archive/review
SCANNER_WAVEFORM_POINTS=512

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Prepared scanner intelligence ---
NEDS_TAKE_CALL_ENRICHMENT_BATCH_SIZE=6
NEDS_TAKE_CALL_ENRICHMENT_MODEL_BATCH_SIZE=6
NEDS_TAKE_CALL_ENRICHMENT_TIMEOUT_SECONDS=60
NEDS_TAKE_RETRANSCRIPTION_DISPATCH_LIMIT=2
NEDS_TAKE_RETRANSCRIPTION_PROFILE=aggressive
NEDS_TAKE_LLM_MAX_TOKENS=3000
NEDS_TAKE_LLM_TIMEOUT_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO
